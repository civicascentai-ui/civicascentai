# LiveKit credentials - DO NOT commit real values
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stable dispatch name. Must exactly match the SIP dispatch rule.
CIVICASCENT_AGENT_NAME=civicascent-voice

# Staging model configuration.
# These defaults are examples from current LiveKit documentation and may incur usage costs.
# Do not enable paid usage without approval.
CIVICASCENT_STT_MODEL=deepgram/nova-3-general
CIVICASCENT_LLM_MODEL=google/gemma-4-31b-it
CIVICASCENT_TTS_MODEL=fishaudio/s2.1-pro
CIVICASCENT_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

LOG_LEVEL=INFO
