# LiveKit credentials - DO NOT commit real values
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Canonical Knowledge Authority
CIVICASCENT_CANONICAL_URL=https://alsjvdqlpayuzykhhbil.supabase.co/functions/v1/canonical-query
# Public Supabase anon key for the staging canonical endpoint. Keep deployment config
# outside Git even though anon keys are not service-role secrets.
SUPABASE_ANON_KEY=

# Human handoff. E.164 (for example +1...) or a full tel:/sip: URI.
# Leave blank in staging until the approved human destination is selected.
CIVICASCENT_HUMAN_TRANSFER_TO=

# Stable dispatch name. Must exactly match the SIP dispatch rule.
CIVICASCENT_AGENT_NAME=civicascent-voice

# Staging model configuration.
# These defaults are examples from current LiveKit documentation and may incur usage costs.
# Do not enable paid usage without approval.
CIVICASCENT_STT_MODEL=deepgram/nova-3-general
CIVICASCENT_LLM_MODEL=google/gemma-4-31b-it
CIVICASCENT_TTS_MODEL=fishaudio/s2.1-pro
CIVICASCENT_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

LOG_LEVEL=INFO
